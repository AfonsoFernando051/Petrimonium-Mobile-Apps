    <StateMachine name="Companion">
      <StateMachineNumber name="state" value="0"/>
      <StateMachineBool name="reducedMotion" value="false"/>
      <StateMachineBool name="interacting" value="false"/>
      <StateMachineLayer name="Mood">
        <EntryState><StateTransition stateToId="idle"/></EntryState>
        <AnyState>
          <StateTransition stateToId="idle" duration="250" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="0.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="notEqual"/>
          </StateTransition>
          <StateTransition stateToId="idle_static" duration="0" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="0.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="equal"/>
          </StateTransition>
          <StateTransition stateToId="celebrate" duration="250" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="1.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="notEqual"/>
          </StateTransition>
          <StateTransition stateToId="celebrate_static" duration="0" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="1.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="equal"/>
          </StateTransition>
          <StateTransition stateToId="think" duration="250" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="2.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="notEqual"/>
          </StateTransition>
          <StateTransition stateToId="think_static" duration="0" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="2.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="equal"/>
          </StateTransition>
          <StateTransition stateToId="sleep" duration="250" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="3.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="notEqual"/>
          </StateTransition>
          <StateTransition stateToId="sleep_static" duration="0" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="3.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="equal"/>
          </StateTransition>
          <StateTransition stateToId="victory" duration="250" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="4.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="notEqual"/>
          </StateTransition>
          <StateTransition stateToId="victory_static" duration="0" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="4.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="equal"/>
          </StateTransition>
          <StateTransition stateToId="happy" duration="250" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="5.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="notEqual"/>
          </StateTransition>
          <StateTransition stateToId="happy_static" duration="0" flags="32">
            <TransitionNumberCondition inputId="state" opValue="equal" value="5.0"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="equal"/>
          </StateTransition>
        </AnyState>
        <AnimationState name="idle" animationId="idle"/>
        <AnimationState name="idle_static" animationId="idle_static"/>
        <AnimationState name="celebrate" animationId="celebrate"/>
        <AnimationState name="celebrate_static" animationId="celebrate_static"/>
        <AnimationState name="think" animationId="think"/>
        <AnimationState name="think_static" animationId="think_static"/>
        <AnimationState name="sleep" animationId="sleep"/>
        <AnimationState name="sleep_static" animationId="sleep_static"/>
        <AnimationState name="victory" animationId="victory"/>
        <AnimationState name="victory_static" animationId="victory_static"/>
        <AnimationState name="happy" animationId="happy"/>
        <AnimationState name="happy_static" animationId="happy_static"/>
        <ExitState/>
      </StateMachineLayer>
      <StateMachineLayer name="Interaction">
        <EntryState><StateTransition stateToId="medallion_rest"/></EntryState>
        <AnyState>
          <StateTransition stateToId="medallion_glow" duration="250" flags="32">
            <TransitionBoolCondition inputId="interacting" opValue="equal"/>
            <TransitionBoolCondition inputId="reducedMotion" opValue="notEqual"/>
          </StateTransition>
          <StateTransition stateToId="medallion_rest" duration="250" flags="32">
            <TransitionBoolCondition inputId="interacting" opValue="notEqual"/>
          </StateTransition>
          <StateTransition stateToId="medallion_rest" duration="0" flags="32">
            <TransitionBoolCondition inputId="reducedMotion" opValue="equal"/>
          </StateTransition>
        </AnyState>
        <AnimationState name="medallion_rest" animationId="medallion_rest"/>
        <AnimationState name="medallion_glow" animationId="medallion_glow"/>
        <ExitState/>
      </StateMachineLayer>
    </StateMachine>
  </Artboard>
