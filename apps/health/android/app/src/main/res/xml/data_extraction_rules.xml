<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) replacement for android:fullBackupContent. Both cloud backup and
  device-to-device transfer are excluded outright rather than filtered per-file: nothing this
  app stores locally is worth moving off the device, and an allow-list would silently start
  including any new file a future feature writes. See AndroidManifest.xml for the reasoning.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
